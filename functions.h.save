/*This is the Library header file, we include all the constants,macros
and function prototypes. */

#ifndef FUNCTIONS_H   //prevent a file from being included multiple times in a single compilation
#define FUNCTIONS_H  //Marks it as included



#define SIZE
void get_input(int numbers[], int size);             //Input numbers from the user and stores them in a array
void display(int numbers[], int size);               //Print number array
void compare_sets(int set1[], int set2[], int size); //Compare two integer arrays one by one
  
void display_pipes(int pnumbers[], int size);        //Print pipes for each number. 



#endif // Ends the protection block
